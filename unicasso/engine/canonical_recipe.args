# The canonical recipe, as a record.
#
# These values ARE the argparse defaults -- running `asciify image.jpg` with no flags
# reproduces this file exactly. It is kept as a separate artifact so that
# `test_recipe.py` can prove that, and so a default that drifts gets caught rather
# than silently changing every future render.
#
# Font-specific values are NOT here: they live in each kit's profile.json "recipe"
# block, because they scale with cell aspect (sfmono 18x36 = 2.00, dejavu 16x34 =
# 2.125). Currently coord_weight_end, coord_weight_end_frac, pool_join_coord_sigma,
# vae_ckpt, and dejavu's ban_chars.
#
# Not included, deliberately:
#   --clip-adapter      domain-adapted CLIP is OFF by default (measured: not worth it)
#   --pixel-nudge-*     weight defaults to 0.0, so its schedule is a no-op

--base-width 60 --iters 3500
--mode swarm --swarm-k 3 --swarm-knn-k 4 --swarm-w-cap 0.5 --swarm-w-decay 0.02
--swarm-w-temp 1.0 --swarm-w-temp-end 0.00 --swarm-w-temp-end-frac 0.9
--swarm-w-temp-cycles 2 --swarm-w-temp-cycle-decay 0.66
--swarm-purge-cycles --swarm-purge-keep 2 --swarm-purge-reseed 1
--swarm-w-noise 0.1 --swarm-phase-gates --swarm-phase-frac 0.75
--swarm-epilogue-frac 0.0 --swarm-epilogue-cycles --swarm-epilogue-temp 0.5 --swarm-epilogue-noise 0.4
--swarm-epilogue-skip-final --swarm-epilogue-cycles-max 2
--swarm-blank-close 10 --swarm-blank-close-ink 0.04 --swarm-boost-cooldown 50
--swarm-boost-ink 0.04
--blank-weight 0.2
--z-noise 0.7 --z-noise-end 0.2 --z-noise-schedule cosine --z-noise-adapt nn1
--z-noise-commit 0.05 --z-noise-quench-frac 0.75
--commit 0.1
--coord-weight 0.1
--orient-weight 1e-2
--clip-snap-weight 0.2 --clip-snap-mode winner --clip-snap-gate entropy --clip-snap-start-frac 0.2
--clip-consist-weight 0.15 --clip-consist-start-frac 0.45
--pool-nominate-rate 25 --pool-nominate-start-frac 0.05 --pool-nominate-end-frac 0.85
--pool-channels latent,blend,affinity,join,pixel,ports --pool-probe --pool-join-every 2
--pool-probe-window 5
--pool-ports-floor 1.0 --pool-ports-gamma 1.0
--pool-diversity-weight 1e-2 --pool-diversity-weight-end 1e-2 --pool-diversity-weight-start-frac 0.15 --pool-grace 50
--pool-probe-rate 1 --pool-probe-memo-ttl 200 --pool-probe-spacing 9 --pool-probe-per-chan 2 --pool-probe-batches 4
--knn-temp 0.8 --knn-temp-end 0.02 --knn-temp-schedule cosine --knn-temp-warmup-frac 0.0 --knn-temp-end-frac 1.0
--pool-affinity-margin -0.25 --pool-latent-margin -0.25
--recon-weight 0.25 --recon-weight-end 0.07 --recon-weight-schedule cosine --recon-weight-end-frac 0.4
--clip-weight 1.2 --clip-crop-scale 0.4 0.9 --clip-scale-alpha 0.8 --clip-aug 16 --clip-rotate 6 --clip-shear 5 --clip-aspect-jitter 0.75 1.3333
--clip-dense-weight 0.25
--affinity-weight 0.0 --affinity-weight-end 5e-3 --affinity-weight-schedule cosine --affinity-weight-start-frac 0.4
--empty-weight 0.18 --empty-temp-scale 0.3 --empty-thresh 0.95 --empty-window 5 --empty-gamma 2.0
--empty-anneal 1 --empty-noise-scale 0.3 --empty-clean-target --empty-clean-sigma 4.0
--clip-content-crop --clip-content-pad 2 --target-white 0.9
--early-stop-patience 6 --early-stop-every 50 --early-stop-div-window 50 --early-stop-div-tol 0.02 --early-stop-frac 0.86
